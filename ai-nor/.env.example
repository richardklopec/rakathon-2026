# LLM gateway (Rakathon portal). Use only EU Data Zone deployments (-dz-eu) for clinical text.
LLM_BASE_URL=https://apim-rakathon-q7146n.azure-api.net/openai/v1/
LLM_API_KEY=
LLM_MODEL=gpt-6-luna-dz-eu
# Embeddings: local multilingual model (no embedding deployment on the gateway; text stays local)
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# mock = no LLM calls, deterministic stub extraction (for UI work / tests)
LLM_MODE=mock

# InterSystems IRIS for Health (local docker, dev credentials)
FHIR_BASE_URL=http://localhost:52773/fhir/r4/
IRIS_HOST=localhost
IRIS_PORT=1972
IRIS_NAMESPACE=FHIRSERVER
IRIS_USER=SuperUser
IRIS_PASSWORD=SYS

# Review policy: fields with confidence >= threshold and no conflict are auto-accepted (0-100)
AUTO_ACCEPT_THRESHOLD=85

# MKN-10 CSV from ÚZIS (01_MKN10_5E_2026_utf8.csv). Relative paths are resolved against the ai-nor folder;
# the default expects Rakathon_DATA_NOR next to the rakathon-2026 repo. Leave empty to use the default.
MKN10_CSV=../../Rakathon_DATA_NOR/Rakathon_DATA_NOR/mkn-10-strukturovane-podklady-20260101/mkn10_strukturovane_podklady_20260101/cp_utf8/01_MKN10_5E_2026_utf8.csv
# Folder with the ÚZIS MKN-10 package for the form's code lists (01_…, 05_…, 07_… CSV, UTF-8 or Windows-1250),
# searched first, MKN10_CSV's folder is the fallback. Relative to the ai-nor folder.
CODELISTS_DIR=uploads
# MKN-10 Tabelární část (PDF from FNO/ÚZIS): coding rules for choosing the MKN-10 code. Relative to ai-nor.
MKN10_RULES_PDF=../../Rakathon_DATA_NOR/Rakathon_DATA_NOR/mkn-tabelarni-cast_1-4-2014_2.pdf
