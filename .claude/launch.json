{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ai-nor-backend",
      "runtimeExecutable": "ai-nor/backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "ai-nor/backend", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "ai-nor-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "ai-nor/frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
